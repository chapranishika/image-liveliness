# Example configuration variables for Secure Face Framework
# Copy this file to .env and populate it with actual keys before running the launcher.
#
# DO NOT commit your .env file containing real keys to the Git repository.

# A 32-byte URL-safe base64-encoded key used to encrypt templates at rest.
# Generate one using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_DB_ENCRYPTION_KEY=YOUR_SECURE_DATABASE_ENCRYPTION_KEY_HERE

# The unique API token checked on headers for accessing Fast API verification endpoints.
# Generate one using: python -c "import secrets; print(secrets.token_urlsafe(32))"
FACE_API_KEY=YOUR_DEVELOPER_API_KEY_HERE
